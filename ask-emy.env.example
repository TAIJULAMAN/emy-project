# Copy this file to ask-emy.env and add the real server-side key.
# Do not put API keys inside the generated HTML pages.

# Optional. If omitted, Ask EMY prefers OpenAI, then OpenRouter, then DeepSeek.
ASK_EMY_PROVIDER=openai

# Direct OpenAI provider.
# OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5.4

# OpenRouter with the DeepSeek free model discussed for Ask EMY.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free

# Alternative direct DeepSeek provider.
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat
